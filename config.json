{
  "name": "SNMP Sensor Server",
  "version": "1.6.1",
  "changelog": "Fix local Supervisor build: Dockerfile now uses ghcr.io/home-assistant/base:3.24. Supervisor 2026.04 no longer passes BUILD_FROM.",
  "slug": "snmpd-sensor-server",
  "description": "SNMP v2c/v3 server for Home Assistant entity states and sys* fields",
  "url": "https://github.com/iShark5060/Home-Assistant-SNMP-Sensor-Server",
  "arch": ["aarch64", "amd64"],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "homeassistant_api": true,
  "options": {
    "sysname": "Home Assistant",
    "community": "public",
    "location": "",
    "name": "",
    "email": "",
    "expose_sensors": true,
    "sensors_to_expose": "all",
    "snmp_version": "v2c",
    "v3_username": "hass",
    "v3_auth_passphrase": "",
    "v3_priv_passphrase": ""
  },
  "schema": {
    "sysname": "str",
    "community": "str?",
    "location": "str",
    "name": "str",
    "email": "str",
    "expose_sensors": "bool",
    "sensors_to_expose": "str",
    "snmp_version": "list(off|v2c|v3|v2c+v3)",
    "v3_username": "str?",
    "v3_auth_passphrase": "password?",
    "v3_priv_passphrase": "password?"
  },
  "ports": {
    "161/udp": 161
  }
}
